# Copy to keystore.properties and fill in real values. The real file is ignored by git and
# must never be committed. The same four values can come from DIALUP_KEYSTORE_FILE,
# DIALUP_KEYSTORE_PASSWORD, DIALUP_KEY_ALIAS and DIALUP_KEY_PASSWORD instead.
storeFile=/absolute/path/to/dialup-release.jks
storePassword=change-me
keyAlias=dialup
keyPassword=change-me
